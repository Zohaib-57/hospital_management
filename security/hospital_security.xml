<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_hospital" model="ir.module.category">
            <field name="name">Hospital Management</field>
            <field name="description">Access rights for Hospital Management module</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_hospital" model="res.groups.privilege">
            <field name="name">Hospital Management</field>
            <field name="category_id" ref="module_category_hospital"/>
        </record>

        <record id="group_hospital_user" model="res.groups">
            <field name="name">Hospital User</field>
            <field name="privilege_id" ref="privilege_hospital"/>
            <field name="comment">Basic hospital operations: manage patients, view doctors and diseases. Cannot delete master data.</field>
        </record>

        <record id="group_hospital_manager" model="res.groups">
            <field name="name">Hospital Manager</field>
            <field name="privilege_id" ref="privilege_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]"/>
            <field name="comment">Full hospital management: complete control over patients, doctors, diseases, and hospital records.</field>
        </record>

        <record id="patient_rule_hospital_user_active_only" model="ir.rule">
            <field name="name">Hospital User: Active Patients Only</field>
            <field name="model_id" ref="model_hospital_patient"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_hospital_user'))]"/>
        </record>

    </data>
</odoo>