<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_patient_wizard_form" model="ir.ui.view">
        <field name="name">hospital.patient.wizard.form</field>
        <field name="model">hospital.patient.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Patient Status">
                <group>
                    <field name="patient_id" readonly="1"/>
                    <field name="current_status"/>
                    <field name="new_status"/>
                    <field name="notes"/>
                    <field name="confirmation_date"/>
                </group>
                <footer>
                    <button name="action_confirm_status" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hospital_patient_wizard" model="ir.actions.act_window">
        <field name="name">Update Patient Status</field>
        <field name="res_model">hospital.patient.wizard</field>
        <field name='view_mode'>form</field>
        <field name="view_id" ref="view_hospital_patient_wizard_form" />
        <field name="target">new</field>
    </record>

</odoo>