<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hospital_medical_history_list" model="ir.ui.view">
        <field name="name">hospital.medical.history.view</field>
        <field name="model">hospital.medical.history</field>
        <field name="arch" type="xml">
            <list string="Medical History">
                <field name="visit_date"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="disease"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hospital_medical_history_form" model="ir.ui.view">
        <field name="name">hospital.medical.history.form</field>
        <field name="model">hospital.medical.history</field>
        <field name="arch" type="xml">
            <form string="Medical History">
                <sheet>
                    <group>

                        <group string="Visit Information">
                            <field name="name"/>
                            <field name="visit_date"/>
                            <field name="patient_id"/>
                            <field name="status"/>
                        </group>

                        <group string="Medical Details">
                            <field name="disease"/>
                            <field name="treatment"/>
                        </group>

                        <group string="Additional Notes">
                            <field name="notes" nolabel="1"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_medical_history" model="ir.actions.act_window">
        <field name="name">Medical History</field>
        <field name="res_model">hospital.medical.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_smiling_face">
                Create a new Medical History Record
            </p>
        </field>
    </record>
</odoo>