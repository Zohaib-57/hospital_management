<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Disease List View -->
    <record id="view_hospital_disease_list" model="ir.ui.view">
        <field name="name">hospital.disease.list</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <list string="Disease">
                <field name="disease_code" />
                <field name="name" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- Disease Form View -->
    <record id="view_hospital_disease_form" model="ir.ui.view">
        <field name="name">hospital.disease.form</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <form string="Disease">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Disease Name" />
                        </h1>
                        <h3>
                            <field name="disease_code" placeholder="Disease Code" />
                        </h3>
                    </div>
                    <group>
                        <field name="active" />
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Disease Search View -->
    <record id="view_hospital_disease_search" model="ir.ui.view">
        <field name="name">hospital.disease.view.search</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <search string="Search Disease">
                <field name="name" string="Disease Name" />
                <field name="disease_code" string="Disease Code" />
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]" />
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <!-- Disease Window Action -->
    <record id="hospital_disease_action" model="ir.actions.act_window">
        <field name="name">Disease</field>
        <field name="res_model">hospital.disease</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Disease record
            </p>
        </field>
    </record>

</odoo>