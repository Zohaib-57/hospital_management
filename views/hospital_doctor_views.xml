<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Doctor Form View -->
    <record id="hospital_doctor_view_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <field name="profile_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Doctor Name"/>
                        </h1>
                        <h3>
                            <field name="doctor_code" placeholder="Doctor Code"/>
                        </h3>
                    </div>
                    <group string="Doctor Status">
                        <field name="availability_status"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Employment">
                        <field name="joining_date" widget="date"/>
                        <field name="experience_years"/>
                        <field name="consultation_fee" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Personal Information">
                            <group>
                                <field name="gender"/>
                                <field name="date_of_birth" widget="date"/>
                            </group>
                        </page>
                        <page string="Contact Information">
                            <group>
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="address"/>
                            </group>
                        </page>
                        <page string="Professional Information">
                            <group>
                                <field name="qualification"/>
                                <field name="specialty"/>
                            </group>
                            <separator string="Biography"/>
                            <field name="biography" widget="html"/>
                        </page>
                        <page string="Additional Notes">
                            <field name="additional_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Doctor List View -->
    <record id="view_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="doctor_code"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="qualification"/>
                <field name="specialty"/>
                <field name="experience_years"/>
                <field name="consultation_fee" widget="monetary"/>
                <field name="joining_date"/>
                <field name="availability_status"/>
            </list>
        </field>
    </record>

    <!-- Doctor Search View -->
    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Search Doctors">
                <!-- Dedicated search input for Doctor Code -->
                <field name="doctor_code" string="Doctor Code"/>

                <!-- Single bar search: type anything to match Name, Code, or Specialty -->
                <field name="name" string="Quick Search (Name / Code / Specialty)" filter_domain="['|', '|', ('name', 'ilike', self), ('doctor_code', 'ilike', self), ('specialty', 'ilike', self)]"/>

                <!-- Other Search Fields -->
                <field name="specialty"/>

                <!-- Preset Filters -->
                <filter string="Available" name="filter_available" domain="[('availability_status', '=', 'available')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>

                <!-- Group By Options -->
                <group>
                    <filter string="Gender" name="groupby_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Specialty" name="groupby_specialty" context="{'group_by': 'specialty'}"/>
                    <filter string="Availability Status" name="groupby_availability" context="{'group_by': 'availability_status'}"/>
                    <filter string="Joining Date" name="groupby_joining_date" context="{'group_by': 'joining_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Doctor Window Action -->
    <record id="hospital_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_doctor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Doctor record</p>
        </field>
    </record>
</odoo>