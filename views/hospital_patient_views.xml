<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Patient Form View -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">

            <form string="Patient">
            <!-- we can also have a default method at the wizard too keep the button simpler here as odoo automatically perform the button action. -->
                <header>
                    <button name="%(action_hospital_patient_wizard)d" string="Update Status" type="action" class="btn-primary" context="{'default_patient_id': id}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="registration_no" readonly="1" placeholder="Auto-generated"/>
                        </h1>
                        <h2>
                            <field name="name" required="1" placeholder="e.g. Ahmed Khan"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="gender" required="1"/>
                            <field name="date_of_birth" required="1" placeholder="Select date of birth"/>
                            <field name="age" readonly="1"/>
                            <field name="registration_date"/>
                            <field name="active"/>
                            <field name="status"/>
                        </group>
                        <group string="Contact Information">
                            <field name="phone" required="1" placeholder="03001234567"/>
                            <field name="email" placeholder="patient@example.com"/>
                        </group>
                    </group>

                    <group>
                        <group string="Doctor Information">
                            <field name="doctor_id" domain="[('active', '=', True)]" context="{'default_availability_status': 'available'}" placeholder="Assign a doctor"/>
                            <field name="doctor_specialty" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="consultation_fee"/>
                        </group>
                        <group string="Medical Details">
                            <field name="disease_ids" widget="many2many_tags" domain="[('active', '=', True)]" placeholder="Select diseases"/>
                            <field name="notes" placeholder="Additional notes about the patient..."/>
                        </group>
                    </group>

                    <group string="Medical History">
                        <field name="medical_history_ids">
                            <list editable="bottom">
                                <field name="visit_date"/>
                                <field name="name"/>
                                <field name="disease"/>
                                <field name="treatment"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Emergency Contact Extension (inherits the Patient form, adds a group AFTER the last group) -->
    <record id="view_patient_form_inherit_emergency" model="ir.ui.view">
        <field name="name">hospital.patient.form.inherit.emergency</field>
        <field name="model">hospital.patient</field>
        <field name="inherit_id" ref="hospital_management.view_hospital_patient_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[last()]" position="after">
                <group string="Emergency Contact">
                    <field name="emergency_contact_name"/>
                    <field name="emergency_contact_phone"/>
                    <field name="emergency_contact_relation"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Patient List View -->
    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="registration_no"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="doctor_id"/>
                <field name="phone"/>
                <field name="registration_date"/>
                <field name="active" column_invisible="True"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name" string="Patient Name"/>
                <field name="doctor_id" string="Doctor"/>
                <field name="disease_ids" string="Disease"/>
                <field name="phone" string="Phone"/>

                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name='filter_inactive' string="Inactive" domain="[('active', '=', False)]"/>

                <separator/>
                <filter name='filter_male' string="Male" domain="[('gender', '=', 'male')]"/>
                <filter name='filter_female' string="Female" domain="[('gender', '=', 'female')]"/>

                <separator/>
                <filter name="filter_has_doctor" string="Assigned to a Doctor" domain="[('doctor_id', '!=', False)]"/>
                <filter name="filter_no_doctor" string="Not Assigned to a Doctor" domain="[('doctor_id', '=', False)]"/>

                <group>
                    <filter string="Doctor" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Gender" name="group_by_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Registration Date" name="group_by_registration_date" context="{'group_by': 'registration_date'}"/>
                    <filter string="Disease" name="group_by_disease" context="{'group_by': 'disease_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Patient Window Action -->
    <record id="hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first patient record!</p>
        </field>
    </record>
</odoo>